+    def _get_env(self, name: str) -> str | None:
+        """*name* from the trial's ``agent.env``, else the host environment.
+
+        Harbor merges ``_extra_env`` into every ``exec``, but ``run()`` also
+        has to *decide* on these values (raise when a key is missing, pick a
+        base URL). Reading only ``os.environ`` misses a caller that hands them
+        over per trial through ``AgentConfig.env`` -- which is how rLLM passes
+        its per-session gateway URL.
+        """
+        if name in self._extra_env:
+            return self._extra_env[name]
+        return os.environ.get(name)
