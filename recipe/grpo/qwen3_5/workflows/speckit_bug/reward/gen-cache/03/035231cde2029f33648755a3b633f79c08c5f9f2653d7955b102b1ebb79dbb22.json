   },
   {
    "reason": "'Do not report to the user' concerns the agent's conversational output, not an artifact, command or file action. No kind in the vocabulary can see it.",
    "statement": "fx-031"
   },
   {
    "reason": "No prohibited_action class covers writes outside the repository except BUG_DIR. repo_write only sees writes inside the repository, so the guardrail can't be expressed.",
    "statement": "fx-034"
   },
