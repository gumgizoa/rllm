# Environment for the recipe/grpo/qwen3_5 recipe.
#
#     cp recipe/grpo/qwen3_5/.env.example recipe/grpo/qwen3_5/.env
#
# train_verl.sh sources this file (ENV_FILE overrides the path). The setup steps
# in README.md -- `rllm dataset pull`, prepare_datasets.py, the `docker pull`
# loops -- run in your own shell *before* train_verl.sh and need the same values,
# so load it there too:
#
#     set -a && source recipe/grpo/qwen3_5/.env && set +a
#
# A shell value wins over the file only if you export it after sourcing; `set -a`
# makes every assignment here an export.

# Datasets, episode logs, eval results. Unset -> ~/.rllm (rllm/paths.py:23).
#
# If you also run Harbor evaluation (recipe/eval), this MUST be a path that
# exists on the host at the same string: Harbor bind-mounts
# $RLLM_HOME/harbor_trials/<trial>/verifier into the task container and the
# *host* docker daemon resolves that path (rllm/integrations/harbor/
# trial_helper.py:160-175). A container-only path leaves reward.txt on the host
# and every task ends in RewardFileNotFoundError.
#
# This recipe on its own does not need that: the native path never bind-mounts.
# tests/ go in as a tar stream (rllm/sandbox/backends/docker.py:256-266), the
# verifier runs in the same task sandbox, and its reward comes back over
# `sandbox.exec("cat ...")` (rllm/eval/script_evaluator.py:137-140). Capacity is
# the only requirement here.
RLLM_HOME=/path/to/rllm-home

# HuggingFace cache. The Qwen3.5-4B snapshot is 8.8 GB, and a container's
# writable layer is usually the small filesystem -- check with
# `findmnt -no SOURCE,FSTYPE -T <path>`. Needs no host visibility, but keep it
# off network storage: eight FSDP workers, eight vLLM servers and the gateway
# all read the snapshot at startup.
HF_HOME=/path/to/hf-cache

HF_HUB_ENABLE_HF_TRANSFER=0

# Where checkpoints and episode logs go (variant=*_swegym only; the base recipe
# keeps verl's `checkpoints/` under the repo and episodes under RLLM_HOME).
# Unset -> RLLM_HOME. Set it when RLLM_HOME is node-local scratch and the
# weights and rollouts must outlive the node: a checkpoint of the 9B is ~110 GB
# (x max_actor_ckpt_to_keep), episodes ~2.5 MB each x 128 per step. Both are
# written once per save_freq / step, so shared storage is fine here where it
# is not for the model snapshot or the venv. Layout:
#   $RLLM_ARTIFACT_DIR/checkpoints/<project>/<experiment>/<RLLM_RUN_ID>/global_step_N
#   $RLLM_ARTIFACT_DIR/episodes/<project>/<experiment>/<RLLM_RUN_ID>/episodes/{train,val}_step_N_epoch_E/*.json
# The training transcript and Hydra's run dir are independent of this: they go
# under RLLM_RUN_DIR (default <repo>/outputs), see train_verl.sh.
# RLLM_ARTIFACT_DIR=/path/to/shared-storage/rllm-artifacts

# Only when the host driver is older than the CUDA 13 stack (R550: `nvidia-smi`
# shows CUDA 12.4). README "Host driver older than the CUDA stack": after
# `apt-get install cuda-compat-13-0` in the container, this puts the
# forward-compatibility libcuda ahead of the host's for the launcher AND for
# every Ray worker / vLLM server it spawns (a shell export reaches only the
# launcher). Leave commented on a host with driver >= 580.
# LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:${LD_LIBRARY_PATH:-}

# train_verl.sh defaults to HF_HUB_OFFLINE=1, so this is only needed when you
# set HF_HUB_OFFLINE=0 and actually want the hub consulted. See README,
# "HuggingFace rate limits".
HF_TOKEN=

# Needed when rllm.trainer.logger contains 'wandb' (config/rllm_grpo.yaml:113).
WANDB_API_KEY=
