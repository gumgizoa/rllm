# SWE-RL v2 training env (no secrets here: wandb reads /root/.netrc).
RLLM_HOME=/opt/dlami/nvme/rllm-work/rllm-home
HF_HOME=/opt/dlami/nvme/hf
MODEL_PATH=/opt/dlami/nvme/hf/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
HF_HUB_OFFLINE=1
RLLM_CKPT_DIR=/opt/dlami/nvme/rllm-work/train_ckpt/smoke1
RLLM_RUN_DIR=/opt/dlami/nvme/rllm-work/train_runs
RLLM_RUN_ID=smoke1
# Same sandbox/grading env as the selection rollouts (env.sh).
RLLM_SANDBOX_ENV=CI=true,VITEST_MIN_FORKS=1,VITEST_MAX_FORKS=1,VITEST_MIN_THREADS=1,VITEST_MAX_THREADS=1
RLLM_SANDBOX_ENV_LANGUAGES=javascript,typescript
RLLM_FRESH_SANDBOX_VERIFY=1
RLLM_DOCKER_CLIENT_TIMEOUT=300
RLLM_HARBOR_SESSION_TIMEOUT_S=4200
RLLM_FRESH_VERIFY_PATCH_DIR=/opt/dlami/nvme/rllm-work/train_patches_smoke1
SWE_RL_V1_STEP_LIMIT=150
WANDB_ENTITY=shinyeongnoh-lg-cns
WANDB_PROJECT=swe-rl-v2
