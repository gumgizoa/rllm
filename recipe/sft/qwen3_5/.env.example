# Reference for the ENV_FILE that qwen3_5/run_megatron_sft.sh sources.
#
#     cp recipe/sft/qwen3_5/.env.example recipe/sft/qwen3_5/.env    # then fill in the secrets
#     ENV_FILE=recipe/sft/qwen3_5/.env bash recipe/sft/qwen3_5/run_megatron_sft.sh
#
# .env is gitignored; this file is not, so never put a real secret here.
# The script sources this with `set -a`, so plain KEY=value only - no `export`, and
# values are not shell-expanded the way `$VAR` would be inside the script.

# --- secrets and cache ---
WANDB_API_KEY=
HF_TOKEN=
# Where model weights are cached. Point it somewhere that survives a container
# recreate - re-downloading Qwen3.5-4B is ~9 GB.
HF_HOME=/path/to/.cache/huggingface

# --- what to train on (required; the script exits 1 if any is unset) ---
# Built by scripts/filter_sft_parquet.py. Absolute paths: the script no longer
# assembles them from a mix name.
TRAIN_FILES=/path/to/train.parquet
VAL_FILES=/path/to/valid.parquet
# The dataset class that renders that parquet for this model family. One per family;
# the parquet contract itself is model-agnostic (see README section 0).
CUSTOM_CLS_PATH=/workspace/rllm/recipe/sft/qwen3_5/dataset.py
CUSTOM_CLS_NAME=Qwen3_5_SFTDataset

# --- chat template (optional) ---
# Omit or leave empty to use the model's stock template. For Qwen3.5 that drops the
# <think> block of every assistant turn before the last user turn, making those turns
# unsupervisable - so set it here, and serve with the same file. See README section 3.
# The launch banner prints which one is in effect.
CHAT_TEMPLATE_PATH=/path/to/rllm/recipe/sft/qwen3_5/chat_templates/qwen3_5_train.jinja

# --- model and run ---
HF_MODEL_PATH=Qwen/Qwen3.5-4B
EXP_NAME=qwen3-5-4b-megatron-swe-sft

# --- batch and sequence length ---
# Global batch, split across DP ranks (128 / DP 8 = 16 rows per rank per step).
TRAIN_BATCH_SIZE=128
MAX_LENGTH=131072
# Token budget per GPU per micro-batch. A sequence is never split, so this cannot go
# below the longest row in the mix; lowering it means re-filtering the data.
MAX_TOKEN_LEN_PER_GPU=131072

# --- parallelism (DP = NUM_GPUS * NNODES / (TP * PP * CP)) ---
# All 1 puts every GPU into data parallelism, which is what a 4.7B model wants on
# 143 GB cards once model.use_fused_kernels is on. See the script's comment.
TP=1
PP=1
CP=1
EP=1
