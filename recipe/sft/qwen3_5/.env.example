# Reference for the ENV_FILE that qwen3_5/run_megatron_sft.sh sources.
#
#     cp recipe/sft/qwen3_5/.env.example recipe/sft/qwen3_5/.env    # then fill in the secrets
#     ENV_FILE=recipe/sft/qwen3_5/.env bash recipe/sft/qwen3_5/run_megatron_sft.sh
#
# .env is gitignored; this file is not, so never put a real secret here.
# The script sources this with `set -a`, so plain KEY=value only - no `export`, and
# values are not shell-expanded the way `$VAR` would be inside the script.

# --- secrets and cache ---
WANDB_API_KEY=
HF_TOKEN=
# Where model weights are cached. Point it somewhere that survives a container
# recreate - re-downloading Qwen3.5-9B is ~19 GB.
HF_HOME=/path/to/.cache/huggingface

# --- what to train on (required; the script exits 1 if any is unset) ---
# Built by scripts/filter_sft_parquet.py. Absolute paths: the script no longer
# assembles them from a mix name.
TRAIN_FILES=/path/to/train.parquet
VAL_FILES=/path/to/valid.parquet
# The dataset class that renders that parquet for this model family. One per family;
# the parquet contract itself is model-agnostic (see README section 0).
CUSTOM_CLS_PATH=/path/to/rllm/recipe/sft/qwen3_5/dataset.py
CUSTOM_CLS_NAME=Qwen3_5_SFTDataset

# --- chat template (optional) ---
# Omit or leave empty to use the model's stock template. For Qwen3.5 that drops the
# <think> block of every assistant turn before the last user turn, making those turns
# unsupervisable - so set it here, and serve with the same file. See README section 3.
# The launch banner prints which one is in effect.
CHAT_TEMPLATE_PATH=/path/to/rllm/recipe/sft/qwen3_5/chat_templates/qwen3_5_train.jinja

# --- model and run ---
HF_MODEL_PATH=Qwen/Qwen3.5-9B
EXP_NAME=qwen3-5-9b-megatron-swe-sft

# --- batch and sequence length ---
# Global batch, split across DP ranks (128 / DP 4 = 32 rows per rank per step).
TRAIN_BATCH_SIZE=128
MAX_LENGTH=131072
# Tokens per GPU per micro-batch. verl packs a micro-batch up to this x CP and CP splits
# it, so 65536 x CP 2 is a 131072-token micro-batch. A sequence is never split across
# micro-batches, so this x CP cannot go below the longest row in the mix; with CP=1 set
# it to 131072. Going lower means re-filtering the data.
MAX_TOKEN_LEN_PER_GPU=65536

# --- parallelism (DP = NUM_GPUS * NNODES / (TP * PP * CP)) ---
# CP=2: at CP=1 a 131k-token micro-batch OOMs the 9B on 143 GB cards even with every
# layer recomputed. See the script's comment.
TP=1
PP=1
CP=2
EP=1

# --- CUDA forward compatibility (only if torch cannot see the GPUs) ---
# The venv's torch is cu130, which needs host driver >= 580. On an older driver
# (`nvidia-smi` says CUDA Version 12.x), torch.cuda.is_available() is False. Install the
# forward-compat libcuda into the container and put it first:
#
#     apt-get update && apt-get install -y cuda-compat-13-0      # -> /usr/local/cuda-13.0/compat
#
# then uncomment and adjust the venv path. The venv's nvidia/cu13 libs come before
# /usr/local/cuda/lib64 so transformer-engine finds the cuBLAS (13.2) it was built for.
# Not shell-expanded: write the whole value, including what LD_LIBRARY_PATH already held.
# LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:/path/to/venv/lib/python3.12/site-packages/nvidia/cu13/lib:/path/to/venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/path/to/venv/lib/python3.12/site-packages/nvidia/nccl/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
